<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>gr.pnet</groupId>
	<artifactId>open5gs-em</artifactId>
	<version>${revision}</version>
	<name>open5gs-em</name>
	<description>TEP API server for Open5GS, including the 3GPP AsSessionWithQoS API backed by the Open5GS PCF</description>
	<url>https://github.com/pnet-software/open5gs-em</url>

	<scm>
		<url>https://github.com/pnet-software/open5gs-em</url>
		<connection>scm:git:https://github.com/pnet-software/open5gs-em.git</connection>
		<developerConnection>scm:git:https://github.com/pnet-software/open5gs-em.git</developerConnection>
	</scm>

	<properties>
		<java.version>17</java.version>
		<!-- CI sets it from the release tag (vX.Y.Z → -Drevision=X.Y.Z) -->
		<revision>1.0.0-SNAPSHOT</revision>
		<openapi-generator.version>7.22.0</openapi-generator.version>
		<springdoc.version>3.1.0</springdoc.version>
		<jacoco.version>0.8.13</jacoco.version>
		<flatten.version>1.7.0</flatten.version>
		<jib.version>3.4.5</jib.version>
		<!-- Not managed by Spring Boot; the generated PCF and SCS/AS clients are OkHttp-based (h2c prior knowledge) -->
		<okhttp.version>4.12.0</okhttp.version>
		<gson-fire.version>1.9.0</gson-fire.version>
		<oltu.version>1.0.2</oltu.version>
		<!-- CI passes -Dimage=docker.io/<namespace>/open5gs-em:<tag> -->
		<image>${project.artifactId}:local</image>
		<jib.from.image>eclipse-temurin:17-jre</jib.from.image>
		<!-- CI passes -Dimage.revision=$GITHUB_SHA -->
		<image.revision>unknown</image.revision>
		<coverage.minimum>0.80</coverage.minimum>
		<coverage.enforce>true</coverage.enforce>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>
		<!-- RestClient.Builder for the AMF/SMF metrics client -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- Runtime of the generated okhttp-gson clients (PCF, SCS/AS notifications) -->
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp</artifactId>
			<version>${okhttp.version}</version>
		</dependency>
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>logging-interceptor</artifactId>
			<version>${okhttp.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<dependency>
			<groupId>io.gsonfire</groupId>
			<artifactId>gson-fire</artifactId>
			<version>${gson-fire.version}</version>
		</dependency>
		<!-- Compile-time only use: the PCF client's generated OAuth helpers, which this app doesn't call -->
		<dependency>
			<groupId>org.apache.oltu.oauth2</groupId>
			<artifactId>org.apache.oltu.oauth2.client</artifactId>
			<version>${oltu.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Integration tests start Mongo with Testcontainers unless TEST_MONGODB_URI is set (CI has no Docker) -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mongodb</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>mockwebserver</artifactId>
			<version>${okhttp.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<executions>
					<!-- The whole northbound API: TEP plus the 3GPP AsSessionWithQoS operations it references -->
					<execution>
						<id>tep-server</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<!-- In static/ so Swagger UI serves the very file the server is generated from -->
							<inputSpec>${project.basedir}/src/main/resources/static/openapi/tep-api.openapi.yaml</inputSpec>
							<output>${project.build.directory}/generated-sources/tep-server</output>
							<generatorName>spring</generatorName>
							<apiPackage>gr.pnet.em.generated.tep</apiPackage>
							<modelPackage>gr.pnet.em.generated.tep.model</modelPackage>
							<supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
							<!-- The 3GPP enums are anyOf(enum, string) -->
							<openapiNormalizer>SIMPLIFY_ANYOF_STRING_AND_ENUM_STRING=true</openapiNormalizer>
							<configOptions>
								<useSpringBoot4>true</useSpringBoot4>
								<delegatePattern>true</delegatePattern>
								<useTags>true</useTags>
								<useJakartaEe>true</useJakartaEe>
								<openApiNullable>false</openApiNullable>
								<unhandledException>true</unhandledException>
								<!-- Unset lists and maps stay null, so non_null responses leave them out -->
								<containerDefaultToNull>true</containerDefaultToNull>
								<!-- No enumUnknownDefaultCase here: as a server, an unknown enum value is a 400, not a silent UNKNOWN -->
								<ignoreAnyOfInEnum>true</ignoreAnyOfInEnum>
							</configOptions>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
						</configuration>
					</execution>
					<!-- Npcf_PolicyAuthorization client: app sessions for AS sessions with QoS -->
					<execution>
						<id>pcf-client</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/static/openapi/TS29514_Npcf_PolicyAuthorization.yaml</inputSpec>
							<output>${project.build.directory}/generated-sources/pcf-client</output>
							<generatorName>java</generatorName>
							<apiPackage>gr.pnet.em.generated.pcfclient</apiPackage>
							<invokerPackage>gr.pnet.em.generated.pcfclient.invoker</invokerPackage>
							<modelPackage>gr.pnet.em.generated.pcfclient.model</modelPackage>
							<configOptions>
								<useJakartaEe>true</useJakartaEe>
								<openApiNullable>false</openApiNullable>
								<enumUnknownDefaultCase>true</enumUnknownDefaultCase>
								<disallowAdditionalPropertiesIfNotPresent>false</disallowAdditionalPropertiesIfNotPresent>
							</configOptions>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelDocumentation>false</generateModelDocumentation>
						</configuration>
					</execution>
					<!-- SCS/AS notification client: forwards the PCF's session events to the SCS/AS -->
					<execution>
						<id>scsas-client</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/static/openapi/TS29122_AsSessionWithQoS.yaml</inputSpec>
							<output>${project.build.directory}/generated-sources/scsas-client</output>
							<generatorName>java</generatorName>
							<apiPackage>gr.pnet.em.generated.scsasclient</apiPackage>
							<invokerPackage>gr.pnet.em.generated.scsasclient.invoker</invokerPackage>
							<modelPackage>gr.pnet.em.generated.scsasclient.model</modelPackage>
							<apisToGenerate>AsSessionWithQoSApiSubscriptionEventsNotificationCallback</apisToGenerate>
							<openapiNormalizer>SIMPLIFY_ANYOF_STRING_AND_ENUM_STRING=true</openapiNormalizer>
							<configOptions>
								<useJakartaEe>true</useJakartaEe>
								<openApiNullable>false</openApiNullable>
								<enumUnknownDefaultCase>true</enumUnknownDefaultCase>
								<disallowAdditionalPropertiesIfNotPresent>false</disallowAdditionalPropertiesIfNotPresent>
							</configOptions>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelDocumentation>false</generateModelDocumentation>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<configuration>
					<failOnNoGitDirectory>false</failOnNoGitDirectory>
					<failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<version>${jib.version}</version>
				<configuration>
					<from>
						<image>${jib.from.image}</image>
					</from>
					<to>
						<image>${image}</image>
					</to>
					<container>
						<user>10001:10001</user>
						<ports>
							<port>8080</port>
							<port>8081</port>
						</ports>
						<creationTime>USE_CURRENT_TIMESTAMP</creationTime>
						<labels>
							<org.opencontainers.image.title>${project.artifactId}</org.opencontainers.image.title>
							<org.opencontainers.image.description>${project.description}</org.opencontainers.image.description>
							<org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
							<org.opencontainers.image.revision>${image.revision}</org.opencontainers.image.revision>
						</labels>
					</container>
					<!-- Drops spring-boot-devtools: Jib starts with java -cp, which would otherwise activate it -->
					<pluginExtensions>
						<pluginExtension>
							<implementation>com.google.cloud.tools.jib.maven.extension.springboot.JibSpringBootExtension</implementation>
						</pluginExtension>
					</pluginExtensions>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.google.cloud.tools</groupId>
						<artifactId>jib-spring-boot-extension-maven</artifactId>
						<version>0.1.0</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>${flatten.version}</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten-clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[${java.version},)</version>
								</requireJavaVersion>
								<banDuplicatePomDependencyVersions/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<exclude>gr/pnet/em/generated/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-it</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<!-- Unit and integration test coverage count together (the Mongo code is covered by the ITs) -->
					<execution>
						<id>merge</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>jacoco.exec</include>
										<include>jacoco-it.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
						</configuration>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<haltOnFailure>${coverage.enforce}</haltOnFailure>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
